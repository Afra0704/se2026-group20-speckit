# 007 Web mode (default). Values below are placeholders; do not commit real secrets.
GUIDED_NOTES_SECRET_KEY=replace-with-a-local-random-secret
GUIDED_NOTES_CLASSROOM_MODE=1
GUIDED_NOTES_DATABASE=instance/classroom-007.sqlite3
GUIDED_NOTES_HTTPS=0
GUIDED_NOTES_PUBLIC_ORIGIN=http://127.0.0.1:5000
GUIDED_NOTES_GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/auth/google/callback
GUIDED_NOTES_GOOGLE_WEB_CLIENT_SECRETS=C:/your-private-folder/web-client.json
GUIDED_NOTES_GOOGLE_TOKEN_KEY_FILE=C:/your-private-folder/web-token.key
# Desktop standalone CLI only. Never used as a Web authentication fallback.
NOTES_GOOGLE_CLIENT_SECRETS=C:/your-private-folder/client.json
NOTES_GOOGLE_TOKEN=C:/your-private-folder/token.json

# 008 optional Google Picker (main client and existing key remain unchanged)
GUIDED_NOTES_GOOGLE_PICKER_CLIENT_SECRETS=C:/path/outside/repository/picker-client.json
GUIDED_NOTES_PICKER_API_KEY=replace-with-website-and-api-restricted-browser-key
GUIDED_NOTES_PICKER_APP_ID=replace-with-google-project-number
